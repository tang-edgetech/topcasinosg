# Public settings baked into the web and backoffice builds on the cPanel
# server (deploy.sh loads this before `next build`). Nothing secret belongs
# here — every NEXT_PUBLIC_ value ends up in the browser. API secrets go in
# api/.env on the server instead (see api.env.example).
NEXT_PUBLIC_API_URL=https://backapi.topcasinosg.com.sg
NEXT_PUBLIC_SITE_URL=https://topcasinosg.com.sg
NEXT_PUBLIC_WEB_URL=https://topcasinosg.com.sg
# Must match COOKIE_PREFIX in api/.env (empty unless another environment
# shares the .topcasinosg.com.sg cookie domain).
NEXT_PUBLIC_COOKIE_PREFIX=
