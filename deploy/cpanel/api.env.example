# Copy to api/.env on the server (never commit it) and fill in the values.
# One KEY=value per line, read literally: quotes are optional.

APP_ENV=production
# Local port the Go API listens on; api/server.cjs forwards
# backapi.topcasinosg.com.sg to it. Pick an unusual one: other accounts on a
# shared server may already use 8090.
PORT=18090

# The cPanel MySQL database and user (both carry your cPanel prefix).
DB_DSN='CPANELUSER_dbuser:PASSWORD@tcp(localhost:3306)/CPANELUSER_topcasinosg?parseTime=true&multiStatements=true&charset=utf8mb4'

# Generate each with:  openssl rand -base64 48   (JWT)  /  openssl rand -hex 16   (OTP, exactly 32 characters)
JWT_SECRET='CHANGE_ME'
OTP_ENCRYPTION_KEY='CHANGE_ME_32_CHARACTERS_EXACTLY!'

CORS_ALLOWED_ORIGINS=https://topcasinosg.com.sg,https://backoffice.topcasinosg.com.sg
COOKIE_DOMAIN=.topcasinosg.com.sg
COOKIE_PREFIX=

# Uploaded media; api/uploads is ignored by git, so deploys never touch it.
UPLOAD_DIR=uploads
