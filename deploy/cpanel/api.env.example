# Copy to api/.env on the server (never commit it) and fill in the values.
# One KEY=value per line, read literally: quotes are optional.

APP_ENV=production
# Local port the Go API listens on; api/server.cjs forwards
# backapi.topcasinosg.com.sg to it. Pick an unusual one: other accounts on a
# shared server may already use 8090.
PORT=18090

# The cPanel MySQL database and user (topcasinosg_topcasinosg for both).
# The real password and secrets live only in api/.env on the server and in
# the git-ignored api/.env.production locally — never in this file.
DB_DSN='topcasinosg_topcasinosg:DB_PASSWORD@tcp(localhost:3306)/topcasinosg_topcasinosg?parseTime=true&multiStatements=true&charset=utf8mb4'

# Generate each with:  openssl rand -base64 48   (JWT)  /  openssl rand -hex 32   (OTP, any length works)
JWT_SECRET='CHANGE_ME'
OTP_ENCRYPTION_KEY='CHANGE_ME'

CORS_ALLOWED_ORIGINS=https://topcasinosg.com.sg,https://backoffice.topcasinosg.com.sg
COOKIE_DOMAIN=.topcasinosg.com.sg
COOKIE_PREFIX=

# Uploaded media; api/uploads is ignored by git, so deploys never touch it.
UPLOAD_DIR=uploads
